# Canonical externally reachable URL (recommended behind any reverse proxy).
BASE_URL=http://localhost

# Only enable forwarded headers when every request reaches Plexio through a
# proxy you control. Prefer BASE_URL for normal deployments.
TRUST_PROXY_HEADERS=false
# ALLOWED_HOSTS=localhost,plexio.example.com

ENABLE_SESSIONS=true
SESSION_DB_PATH=/data/sessions.db
MAX_SESSIONS=1000
# ADMIN_KEY=replace-with-a-long-random-value
# SESSION_ENCRYPTION_KEY=replace-with-a-fernet-key
ENABLE_LEGACY_URLS=false
MAX_REQUEST_BODY_SIZE=65536
PUBLIC_API_RATE_LIMIT=60

PLEX_REQUESTS_TIMEOUT=20
# PLEX_MATCHING_TOKEN=
CACHE_TYPE=memory
REDIS_URL=redis://redis:6379/0
# CORS_ORIGIN_REGEX=
# SENTRY_DSN=
